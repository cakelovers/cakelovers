NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Public origin used to build customer-facing links in server-generated
# content (the payment-request message's order URL). Optional: when unset,
# the app derives the origin from the request's forwarded-host headers,
# which is correct on Vercel. Set it to pin the domain, e.g.
# https://cakelovers.app
NEXT_PUBLIC_SITE_URL=
